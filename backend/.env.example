# ---- Reel Studio render service (MoviePy) ----------------------------------
# Copy to .env for local runs. On Railway/Render/Fly set these as env vars.

# Comma-separated frontend origins allowed to upload. "*" is dev-only —
# set your real Vercel URLs in production.
ALLOWED_ORIGINS=http://localhost:3000,https://vide-gen-beige.vercel.app

# Port the service listens on (most platforms inject this for you).
PORT=8000

# Where job working directories live. Must be writable and have room for the
# uploaded clips plus the output.
WORK_DIR=/data/jobs

# Total bytes accepted per render request (all clips + music + closing frame).
MAX_UPLOAD_MB=1024

# Finished jobs and their temp files are deleted this long after completion.
JOB_TTL_SECONDS=3600

# Renders are CPU-bound; more than one at a time on a small box helps nobody.
MAX_CONCURRENT_RENDERS=1

# 0 = let ffmpeg use every core. Set a number on shared/limited CPU plans.
FFMPEG_THREADS=0

# x264 preset. ultrafast..veryslow — trades encode time against file size.
FFMPEG_PRESET=veryfast
VIDEO_BITRATE=6M
AUDIO_BITRATE=192k

# How a music track shorter than 30s is handled:
#   silence = pad with silence (matches the in-browser renderer)
#   loop    = repeat the track
MUSIC_PAD_MODE=silence

# Optional shared secret. When set, callers must send `X-API-Key: <value>`,
# and the frontend must have RENDER_API_KEY set to the same value.
# Leave empty only if the service isn't reachable from the public internet.
RENDER_API_KEY=
