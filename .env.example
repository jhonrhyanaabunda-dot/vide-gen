# ============================================================================
# Frontend (Next.js on Vercel)
# ============================================================================

# ---- MoviePy render backend ------------------------------------------------
# Base URL of the render service in backend/ (no trailing slash). Leave EMPTY
# to keep the original behaviour: everything renders in the browser with
# FFmpeg.wasm and no backend is contacted at all.
#
# The browser uploads footage straight to this URL rather than through Vercel,
# because Vercel caps request bodies at 4.5 MB. That means:
#   * the service needs a public HTTPS URL, and
#   * its ALLOWED_ORIGINS must list this site's origin.
# Local dev:  http://localhost:8000
NEXT_PUBLIC_RENDER_BACKEND_URL=

# Optional shared secret; must equal RENDER_API_KEY on the service.
# NOTE: NEXT_PUBLIC_* values are compiled into the client bundle and are
# therefore visible to anyone who opens the page. This gate keeps casual
# traffic off your renderer — it is not authentication. For real access
# control put the service on a private network or behind SSO.
NEXT_PUBLIC_RENDER_API_KEY=

# ---- Gemini (AI clip selection) --------------------------------------------
# These stay on Vercel: /api/match-clips and /api/vision-scan are lightweight
# JSON calls that suit serverless. Only video rendering moved to MoviePy.
#
# Optional server-side fallback key. The app primarily uses the Gemini key the
# user types into the dashboard (sent per-request to the API routes). If you'd
# rather keep a single key on the server instead of trusting client input, set
# this and the API routes will fall back to it when no key is in the request.
#
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model overrides (optional). gemini-2.0-flash handles both text and vision.
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Legacy OpenAI fallback (optional). If set and no Gemini key is present, the
# routes will still try this — but the default endpoint is Gemini's.
OPENAI_API_KEY=

# ============================================================================
# Render service env vars live in backend/.env.example
# ============================================================================
