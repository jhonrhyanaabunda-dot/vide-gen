# Optional server-side fallback key. The app primarily uses the Gemini key the
# user types into the dashboard (sent per-request to the API routes). If you'd
# rather keep a single key on the server instead of trusting client input, set
# this and the API routes will fall back to it when no key is in the request.
#
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model overrides (optional). gemini-2.0-flash handles both text and vision.
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Legacy OpenAI fallback (optional). If set and no Gemini key is present, the
# routes will still try this — but the default endpoint is Gemini's.
OPENAI_API_KEY=
